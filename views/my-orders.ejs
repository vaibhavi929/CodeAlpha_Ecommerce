<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Orders - E-Shop</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body>

    <div class="container mt-5">

        <h1>My Orders</h1>

        <% if (orders.length === 0) { %>

            <div class="alert alert-info mt-4">
                You have not placed any orders yet.
            </div>

        <% } else { %>

            <% orders.forEach(order => { %>

                <div class="card mt-4">

                    <div class="card-body">

                        <h5>
                            Order #<%= order.id %>
                        </h5>

                        <p>
                            Total:
                            ₹<%= order.total_amount %>
                        </p>

                        <p>
                            Status:
                            <%= order.status %>
                        </p>

                        <p>
                            Date:
                            <%= order.order_date %>
                        </p>

                    </div>

                </div>

            <% }) %>

        <% } %>

        <a href="/products" class="btn btn-primary mt-4">
            Continue Shopping
        </a>

    </div>

</body>

</html>