<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Checkout - E-Shop</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body>

    <div class="container mt-5">

        <h1>Checkout</h1>

        <div class="card mt-4">

            <div class="card-body">

                <h4>Customer Details</h4>

                <p>
                    Name: <%= user.name %>
                </p>

                <p>
                    Email: <%= user.email %>
                </p>

            </div>

        </div>


        <div class="card mt-4">

            <div class="card-body">

                <h4>Order Summary</h4>

                <% cart.forEach(product => { %>

                    <div class="mb-3">

                        <strong>
                            <%= product.name %>
                        </strong>

                        <p>
                            Quantity: <%= product.quantity %>
                        </p>

                        <p>
                            ₹<%= product.price * product.quantity %>
                        </p>

                    </div>

                <% }) %>


                <hr>

                <h4>
                    Total: ₹<%= total %>
                </h4>


                <form action="/place-order" method="POST">

                    <button
                        type="submit"
                        class="btn btn-success mt-3"
                    >
                        Place Order
                    </button>

                </form>

            </div>

        </div>

    </div>

</body>

</html>